---
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import SourceFeed from "../../components/gather/SourceFeed.astro";
import CitationList from "../../components/gather/CitationList.astro";
import { getGatherFeed } from "../../utils/gather-feed";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: article, error, cacheHint } = await getEmDashEntry("articles", slug);
if (error) return new Response("Unable to load article", { status: 500 });
if (!article) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(article, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const categories = article.data.terms?.category ?? [];
const tags = article.data.terms?.tag ?? [];
const categorySlug = categories[0]?.slug;
const { entries: related, cacheHint: relatedCacheHint } = categorySlug
	? await getEmDashCollection("articles", {
			where: { category: categorySlug },
			orderBy: { published_at: "desc" },
			limit: 5,
		})
	: { entries: [], cacheHint: null };
if (Astro.cache?.enabled && relatedCacheHint) Astro.cache.set(relatedCacheHint);

const others = related.filter((item) => item.id !== article.id).slice(0, 4);
const feed = await getGatherFeed(Astro.url.origin, article.id);
const published = article.data.publishedAt
	? article.data.publishedAt.toLocaleDateString("en-GB", {
			day: "2-digit",
			month: "long",
			year: "numeric",
		})
	: "Undated";
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "articles", id: article.data.id, slug }}
>
	<header class="article-head">
		<div class="mono">
			<span class="section-head__mark">{article.data.region} / {categories[0]?.label ?? "News"}</span>
			{article.data.breaking && <span class="section-head__mark">Breaking</span>}
		</div>
		<h1 class="article-head__title" {...article.edit.headline}>{article.data.headline}</h1>
		{article.data.dek && <p class="article-head__dek" {...article.edit.dek}>{article.data.dek}</p>}
		<div class="meta">
			{article.data.bylines?.map((credit) => (
				<span>By <strong>{credit.byline.displayName}</strong>{credit.roleLabel ? ` / ${credit.roleLabel}` : ""}</span>
			))}
			<span>{published}</span>
			<span>{article.data.region} edition</span>
		</div>
	</header>

	<div class="article-shell">
		<div class="article-main">
			{
				article.data.hero_image && (
					<figure class="article-figure" {...article.edit.hero_image}>
						<Image image={article.data.hero_image} priority />
						{article.data.hero_image.alt && (
							<figcaption class="mono">{article.data.hero_image.alt}</figcaption>
						)}
					</figure>
				)
			}
			<div class="prose"><PortableText value={article.data.content} /></div>
			<SourceFeed articleId={article.id} entries={feed.entries} reachable={feed.reachable} />
			<CitationList entries={feed.entries} />
			{
				tags.length > 0 && (
					<div class="tag-row">
						{tags.map((tag) => (
							<span>#{tag.label}</span>
						))}
					</div>
				)
			}
		</div>

		<aside class="article-aside">
			<h2>More in {categories[0]?.label ?? "the news"}</h2>
			{others.length > 0 ? (
				<ul>
					{others.map((item) => (
						<li><a href={`/articles/${item.id}`}>{item.data.headline}</a></li>
					))}
				</ul>
			) : (
				<p class="mono">No other stories in this section yet.</p>
			)}
			<div class="meta"><a href={`/category/${categorySlug ?? "world"}`}>View section →</a></div>
		</aside>
	</div>
</Base>
