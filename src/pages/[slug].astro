---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, error, cacheHint } = await getEmDashEntry("pages", slug);
if (error) return new Response("Unable to load page", { status: 500 });
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<header class="article-head">
		<div class="mono"><span class="section-head__mark">Page</span></div>
		<h1 class="article-head__title" {...page.edit.title}>{page.data.title}</h1>
	</header>
	<div class="article-shell">
		<div class="article-main prose"><PortableText value={page.data.content} /></div>
	</div>
</Base>
