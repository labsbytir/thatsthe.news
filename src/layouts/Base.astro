---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const today = new Date().toLocaleDateString("en-GB", {
	day: "2-digit",
	month: "short",
	year: "numeric",
});

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<div class="wrap masthead">
				<div class="masthead__side mono">
					Independent newsroom<br />Est. 2026 / No. 001
				</div>
				<div>
					<h1 class="masthead__title">{siteTitle}</h1>
					<p class="masthead__tagline">{siteTagline}</p>
				</div>
				<div class="masthead__side masthead__side--right mono">
					Updated around the clock<br />{today} / live edition
				</div>
			</div>
			<nav class="site-nav wrap" aria-label="Primary">
				{
					menu?.items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={path === item.url ? "page" : undefined}
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</header>

		<main class="wrap"><slot /></main>

		<footer class="site-footer">
			<div class="wrap footer-grid">
				<span>{siteTitle} / all copy editable in EmDash</span>
				<span>Local preview — not deployed</span>
				<a href="/_emdash/admin/">Editor login</a>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
