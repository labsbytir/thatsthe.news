{
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"esModuleInterop": true,
		"declaration": true,
		"sourceMap": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
